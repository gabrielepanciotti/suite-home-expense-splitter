{
  "schemaVersion": "2.0",
  "name": "HomeExpenseSplitter",
  "slug": "homeExpenseSplitter",
  "type": "fastapi-react-app",
  "visibility": "public",
  "hostBase": "homeexpensesplitter.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": { "id": "homeExpenseSplitter", "cluster": ["Home"], "displayName": "HomeExpenseSplitter", "former": "CasaConti", "commercial": false },
  "tooling": {},
  "capabilities": ["build", "test", "deploy"],
  "vista": {
    "sezioni": [
      { "id": "saldo", "titolo": "Saldo", "min": "player" },
      { "id": "spese", "titolo": "Spese condivise", "min": "player" },
      { "id": "esporta", "titolo": "Esporta", "min": "creator" }
    ],
    "azioni": {
      "saldo.salva": "creator",
      "rimborso.segna": "creator",
      "rimborso.annulla": "creator",
      "export.scarica": "creator"
    }
  },
  "agents": { "archetypes": [] },
  "mcp": { "toolsets": ["brain", "db"], "readOnly": true },
  "deploy": {
    "backendPkg": "home_expense_splitter_backend",
    "appModule": "home_expense_splitter_backend.app:app",
    "healthPath": "/health",
    "migrations": false,
    "database": {
      "name": "homeexpensesplitter",
      "user": "homeexpensesplitter",
      "host": "homeexpensesplitter-db",
      "driver": "postgresql+psycopg",
      "image": "postgres:16-alpine",
      "volume": "homeexpensesplitter_pgdata"
    }
  },
  "portsNote": "Ports are registry-driven (docs/ports.registry.json), resolved by conform (front/back/db). Deprecated node.config.ports field removed (drift: carried stale 3339/10005/11117 vs registry 3343/10009/11121). migrations:false — alembic.ini lives at repo root (script_location %(here)s/backend/...) and is not copied into the backend image (only backend/ is), so `alembic upgrade head` can't run in-container: the volume must ALREADY be at head when the backend starts, and nothing enforces that. On 2026-08-09 the deployed volume was found empty (0 tables) while this note claimed it was at head — the node had degraded to an empty-but-mounted volume, which looks healthy. Data was restored from the real 0003 snapshot; whoever moves this node must dump/restore and then verify ROW COUNTS through the API, never the container status. Legacy 8018/3018 retired per node-standardization-roadmap §0bis.",
  "children": []
}
