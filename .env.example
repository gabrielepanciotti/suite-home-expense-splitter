# HomeExpenseSplitter — environment template.
# Copy to .env (UNTRACKED) and fill in real values. NEVER commit .env.
# Rule: personal names live ONLY here (device-local), never in tracked files.

# --- Database -----------------------------------------------------------------
DB_PASSWORD=example-not-a-secret
DB_HOST_PORT=11121
# Host-dev DB URL (alembic + CLI on the host). Containers get DATABASE_URL from compose.
HOMEEXPENSESPLITTER_DATABASE_URL=postgresql+psycopg://homeexpensesplitter:example-not-a-secret@localhost:11121/homeexpensesplitter

# --- Split source (issue #4) ---------------------------------------------------
# finance = the finance node (Life#81), which owns the ledger (default). No silent fallback:
#           if finance is down, /api/summary answers 503 instead of a stale balance.
# ledger  = the frozen local archive (parity checks only)
# HOMEEXPENSESPLITTER_SPLIT_SOURCE=finance
# Host dev: http://127.0.0.1:10023 · containers on personal-net: http://finance-backend:10023
# FINANCE_URL=http://127.0.0.1:10023

# --- Telegram bot ---------------------------------------------------------------
# HOMEEXPENSESPLITTER_TELEGRAM_TOKEN=123456:replace-me

# --- Member display aliases (device-local, frontend/display only) --------------
# The app uses generic ids (member_a / member_b) and generic display defaults
# ("Member A" / "Member B"). To show real names in the UI on THIS device only,
# set the alias map below (fictional sample values):
# MEMBER_ALIASES_JSON={"member_a": "Alice", "member_b": "Bob"}

# --- Bank import counterparty matching (device-local) ---------------------------
# ";"-separated counterparty names, matched casefolded by the BBVA importer.
# BANK_SELF_NAMES: names identifying the account holder (self-transfers → giroconto).
# BANK_MEMBER_B_NAMES: names identifying the other member (→ member_transfer).
# Fictional samples:
# BANK_SELF_NAMES=alice rossi
# BANK_MEMBER_B_NAMES=bob bianchi;robert bianchi

# --- Legacy workbook sheet names (only if your historical Excel used custom ones)
# LEGACY_SHARED_SHEET=Spese Condivise
# LEGACY_PERSONAL_SHEET=Spese Personali

# --- One-off data depersonalization (migration 0003) ----------------------------
# Word-boundary tokens scrubbed from existing transaction descriptions/notes.
# Keys are the replacement, values the token list (longest first). Fictional sample:
# DEPERSONALIZE_TOKENS_JSON={"Member A": ["alice rossi", "alice"], "Member B": ["bob bianchi", "bob"]}
# >>> suite-managed (env) >>>
# Copy to .env — the generated compose fails fast when DB_PASSWORD is
# unset (no silent default is baked into the committed compose files).
# NOTE: compose reads interpolation vars from the project directory
# (deploy/), not the node root — launch with the root env explicitly:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
# Dev default below matches the node's DB identifiers; use a real
# secret outside local dev. .env is gitignored, this file is tracked.
DB_PASSWORD=example-not-a-secret
# Host port for the node DB (published on 127.0.0.1 only); the value
# below is the registry default — override only on port conflicts.
DB_HOST_PORT=11121
# <<< suite-managed (env) <<<
