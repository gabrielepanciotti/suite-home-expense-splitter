# syntax=docker/dockerfile:1.7
# suite-managed (deploy) — regenerated by conform, do not edit by hand.
# Frontend HomeExpenseSplitter (homeExpenseSplitter). design-system i18n injected as
# tarballs (npm pack): the npm-link symlink does not exist in Docker. Pre-build:
# deploy/prebuild.sh generates frontend/vendor/suite-<name>.tgz for each.
#
# TWO STAGES, one image file:
#   dev  — the Vite dev server, hot reload on, built by
#          deploy/docker-compose.yml (target: dev); frontend/ is
#          bind-mounted at runtime so edits reach the browser without a rebuild.
#   prod — `npm run build` + nginx serving the static bundle, built by
#          deploy/docker-compose.prod.yml (target: prod). A dev server is not a
#          production server: no bundling, no minification, no cache headers.
# `dev` is the LAST stage on purpose: a bare `docker build` with no --target
# keeps the hot-reload behaviour, so a node whose compose predates the split
# does not silently get a production image.
FROM node:20-alpine AS deps
WORKDIR /app
# Generous npm retry/timeouts: on slow links (the mini-PC) downloads failed
# with ETIMEDOUT mid-build.
ENV npm_config_fetch_timeout=600000 \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000
COPY frontend/package.json ./
COPY frontend/vendor/suite-design-system.tgz frontend/vendor/suite-i18n.tgz ./vendor/
# npm 10.8 (node:20) crashes in arborist #loadPeerSet ("reading 'edgesOut'") on
# optional peers such as vitest 4's (Life#218): install npm 11 first.
RUN npm install -g npm@11 --no-audit --no-fund \
    && npm pkg set dependencies.@suite/design-system=file:./vendor/suite-design-system.tgz \
    && npm pkg set dependencies.@suite/i18n=file:./vendor/suite-i18n.tgz \
    && npm install --no-audit --no-fund
COPY frontend/ ./

# ---------------------------------------------------------------- prod stage
FROM deps AS build
# VITE_BASE: the node's path behind the instance portal (node.config
# deploy.portalPath, passed by docker-compose.prod.yml). Empty = served at "/".
ARG VITE_BASE=
# Widget output is generated on the host by deploy/prebuild.sh: Life itself is
# outside this Docker build context, so skip only npm's matching prebuild hook.
RUN if node -e 'var p=require("./package.json");process.exit(p.scripts&&p.scripts.prebuild&&p.scripts.prebuild.indexOf("generate-dashboard-widgets.mjs")>=0?0:1)'; then \
      npm run build --ignore-scripts -- ${VITE_BASE:+--base "$VITE_BASE"}; \
    else \
      npm run build -- ${VITE_BASE:+--base "$VITE_BASE"}; \
    fi

FROM nginx:1.27-alpine AS prod
RUN rm /etc/nginx/conf.d/default.conf
# Generated next to this Dockerfile by conform; it listens on 3343
# so deploy/Caddyfile's reverse_proxy target is the same in both profiles.
COPY deploy/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 3343
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3343/healthz || exit 1

# ----------------------------------------------------------------- dev stage
FROM deps AS dev
# Polling watcher tuned for Docker bind-mounts (cosmos + launcher lessons):
# a 2s poll interval keeps CPU sane on large trees, and a bigger libuv thread
# pool stops fs polling from starving Vite's transform pipeline.
ENV CHOKIDAR_USEPOLLING=true \
    CHOKIDAR_INTERVAL=2000 \
    UV_THREADPOOL_SIZE=16
EXPOSE 3343
# Generous timeout/start-period: the Vite dev server can take >10s to warm up
# (dependency pre-bundling on first boot), and a polling watcher makes the
# first response slow — a 5s/10s probe flapped containers as "unhealthy".
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3343/ || exit 1
CMD ["sh", "-c", "npm run dev -- --host 0.0.0.0 --port 3343"]
